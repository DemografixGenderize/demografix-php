{
    "name": "demografix/demografix",
    "description": "Predict gender, age, and nationality from names. Official PHP client for the genderize.io, agify.io, and nationalize.io APIs, with batches of up to 100 names per request.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "gender",
        "age",
        "nationality",
        "name",
        "first name",
        "gender detection",
        "gender from name",
        "gender api",
        "age prediction",
        "name prediction",
        "demographics",
        "batch",
        "bulk",
        "api",
        "api client",
        "genderize",
        "agify",
        "nationalize",
        "demografix"
    ],
    "homepage": "https://github.com/DemografixGenderize/demografix-php",
    "support": {
        "issues": "https://github.com/DemografixGenderize/demografix-php/issues",
        "source": "https://github.com/DemografixGenderize/demografix-php"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Demografix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Demografix\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
